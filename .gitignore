# 실제 값이 든 환경 파일. 예시(.env.nas.example)만 추적한다.
.env
.env.*
!.env.*.example

# ⚠️ 위 패턴은 **점으로 시작하는 이름만** 잡는다. nas/env/ 의 파일들은
#    auth.env · as.env · meters.env 라 걸리지 않아 그대로 추적 대상이 된다.
#    거기에는 카카오 시크릿, SMTP 비밀번호, SSO 클라이언트 시크릿이 들어간다.
#    파일이 아직 없어서 사고가 안 났을 뿐이고, 만드는 순간 커밋된다.
#    (2026-09-02 세션 종료 점검에서 발견)
nas/env/*.env
!nas/env/*.example

# DB 덤프. 실 데이터가 들어 있으므로 절대 커밋하지 않는다.
*.dump
*.sql.gz
before-*.txt
after-*.txt

# 이관 중 만들어지는 작업 파일
rehearsal/
tmp/

# OS
Thumbs.db
.DS_Store
