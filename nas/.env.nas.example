# 이 파일은 예시용이며 실제 값이 아닙니다. 절대 실제 비밀번호를 여기 넣지 마세요.
# 실제 값은 NAS의 .env.nas(Git 추적 제외)에만 둡니다.
#
# ⚠️ 이 값들은 컨테이너가 **처음 만들어질 때** 롤 비밀번호로 굳는다.
#    나중에 이 파일만 고쳐도 이미 만들어진 롤의 비밀번호는 바뀌지 않는다.
#    바꾸려면 psql로 ALTER ROLE ... PASSWORD 를 직접 해야 한다.

# ─── 업무용 인스턴스 (dss-pg-app) ─────────────────────────────────────
# 부트스트랩 슈퍼유저. 앱은 이 계정을 쓰지 않는다 — 초기화와 관리 전용이다.
APP_POSTGRES_USER=dss_admin
APP_POSTGRES_PASSWORD=

# 앱 롤 셋. **서로 다른 값이어야 한다** — 초기화 스크립트가 겹치면 거절한다.
# 생성: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AS_APP_PASSWORD=
METERS_APP_PASSWORD=
# 개선요청 (2026-09-18 더함). 이 줄이 없으면 compose 가 DATABASE_URL 을
# 비밀번호 없이 조립해 app-improvements 가 DB 에 붙지 못한다.
IMPROVEMENTS_APP_PASSWORD=
# 휴가 (2026-09-29 더함). 위와 같다 — 없으면 app-leave 가 DB 에 못 붙는다.
# 🔴 이 값은 NAS 의 DB 롤 dss_leave_app 에 넣은 것과 **글자 하나까지 같아야** 한다.
#    둘을 한자리에서 정하는 것이 setup/13-leave-pw.sh 다.
LEAVE_APP_PASSWORD=

# 🔴 PO / 내자는 여기에 줄이 없다. 빠뜨린 것이 아니다 — A/S 와 **같은 dss_as** 를
#    **같은 롤 dss_app** 으로 보므로 위 AS_APP_PASSWORD 를 그대로 쓴다.
#    새 사이트를 세울 때: 자기 DB 를 가지면 줄이 하나 늘고, 남의 DB 를 보면 안 는다.

# ─── 인증용 인스턴스 (dss-pg-auth) ────────────────────────────────────
AUTH_POSTGRES_USER=dss_admin
AUTH_POSTGRES_PASSWORD=

# 위 둘과도 달라야 한다. 인증 DB를 따로 세운 이유가 여기서 무너지면 안 된다.
AUTH_APP_PASSWORD=

# ─── 참고 ─────────────────────────────────────────────────────────────
# 각 앱의 DATABASE_URL은 이 파일이 아니라 그 앱의 운영 env에 둔다.
# 형태는 이렇다 (포트를 노출하지 않으므로 서비스 이름으로 부른다):
#
#   A/S       postgresql://dss_app:***@dss-pg-app:5432/dss_as
#   계측기     postgres://dss_meters_app:***@dss-pg-app:5432/dss_meters
#   개선요청   postgres://dss_improvements_app:***@dss-pg-app:5432/dss_improvements
#   통합 로그인 postgresql://dss_auth_app:***@dss-pg-auth:5432/dss_auth
#
# 넷 다 실제로는 compose 가 조립해 넘긴다(위 비밀번호 + 서비스 이름).
# env/*.env 에 또 적지 않는다 — 같은 값이 두 곳에 생기면 언젠가 한쪽만 바뀐다.
